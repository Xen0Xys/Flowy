### DATABASE ###
DATABASE_URL="postgres://postgres:postgres@localhost:5432/postgres"

### CORE (required) ###
APP_NAME=Flowy
# Generate with: openssl rand -hex 32. Seeds the MFA TOTP AEAD key, keep it stable.
APP_SECRET=
CORS_ORIGINS=http://localhost:3000

### CORE (optional) ###
# API path prefix behind a reverse proxy (e.g. /api)
PREFIX=

### WEBAUTHN ###
# WEBAUTHN_RP_ID is REQUIRED in production (Docker defaults to production).
# Hostname only, no scheme, no port. Changing it invalidates every registered passkey.
# Uncomment and set to your frontend hostname (in dev only, derived from CORS_ORIGINS if unset).
# WEBAUTHN_RP_ID=
WEBAUTHN_RP_NAME=
WEBAUTHN_ORIGINS=

### SSO (optional) ###
# Required as soon as one SSO_<N>_* provider is declared below.
# FRONTEND_URL: absolute URL of the frontend (user is redirected here after callback).
# BACKEND_URL:  public URL of the backend (used as OAuth redirect_uri host).
#               Defaults to http://localhost:$PORT$PREFIX; set behind a reverse proxy or on a public host.
FRONTEND_URL=
BACKEND_URL=

# Provider template (Discord). Uncomment and fill CLIENT_ID / CLIENT_SECRET to enable.
# Repeat with SSO_2_*, SSO_3_*, ... for extra providers.
# See DEPLOYMENT.md §2.3 for GitHub, Google, Entra ID, GitLab, Keycloak examples.
# SSO_1_KIND=oauth2
# SSO_1_SLUG=discord
# SSO_1_DISPLAY_NAME=Discord
# SSO_1_ICON=simple-icons:discord
# SSO_1_CLIENT_ID=
# SSO_1_CLIENT_SECRET=
# SSO_1_AUTHORIZATION_URL=https://discord.com/oauth2/authorize
# SSO_1_TOKEN_URL=https://discord.com/api/oauth2/token
# SSO_1_USERINFO_URL=https://discord.com/api/users/@me
# SSO_1_SCOPES=identify,email
# SSO_1_EMAIL_CLAIM=email
# SSO_1_USERNAME_CLAIM=username
# SSO_1_SUB_CLAIM=id
