DATABASE_URL="postgres://postgres:postgres@localhost:5432/postgres"
APP_NAME=Flowy
# Generate with: openssl rand -hex 32
# NEVER reuse this placeholder in production; APP_SECRET seeds the MFA TOTP AEAD key.
APP_SECRET=change-me-generate-with-openssl-rand-hex-32
CORS_ORIGINS=http://localhost:3000

# WebAuthn Relying Party
# WEBAUTHN_RP_ID: hostname only (no scheme, no port). REQUIRED in production.
#   Changing this value invalidates every previously registered passkey; keep it stable.
#   In development, if unset, it is derived from the first CORS_ORIGINS entry.
# WEBAUTHN_RP_NAME: human-readable name shown by the OS credential picker; defaults to APP_NAME.
# WEBAUTHN_ORIGINS: comma-separated origins allowed by WebAuthn; defaults to CORS_ORIGINS.
WEBAUTHN_RP_ID=
WEBAUTHN_RP_NAME=
WEBAUTHN_ORIGINS=

# ============================================================================
# Single Sign-On (SSO)
# ============================================================================
# Flowy supports any number of OAuth 2.0 or OIDC providers, configured entirely
# through environment variables. Providers are declared with the SSO_<N>_*
# prefix, where <N> is any positive integer grouping the variables of the same
# provider. The order of <N> values controls the display order on the login page.
#
# Restart the backend after any change to reload the configuration.
# The instance owner can inspect the loaded providers under
# Settings > SSO (read-only view with the redirect URI to register).
#
# See DEPLOYMENT.md section 2.3 for the full reference.
# ----------------------------------------------------------------------------

# Absolute URL of the frontend, used to redirect users back after callback.
# REQUIRED when at least one SSO provider is defined.
# FRONTEND_URL=https://flowy.example.com

# Optional: override the base URL the backend uses to build callback URLs.
# Defaults to http://localhost:$PORT for local dev; set this when the backend
# is behind a reverse proxy or exposed on a distinct public hostname.
# SSO_CALLBACK_BASE_URL=https://flowy.example.com/api

# ----------------------------------------------------------------------------
# Common fields (every provider)
# ----------------------------------------------------------------------------
# SSO_<N>_KIND                    oidc | oauth2
# SSO_<N>_SLUG                    unique lowercase identifier ([a-z0-9-]), appears in URLs
# SSO_<N>_DISPLAY_NAME            label shown on the login button
# SSO_<N>_ICON                    Iconify icon name (e.g. simple-icons:github, iconoir:key)
# SSO_<N>_CLIENT_ID               OAuth client ID
# SSO_<N>_CLIENT_SECRET           OAuth client secret
# SSO_<N>_SCOPES                  comma-separated (required for oauth2, default "openid,email,profile" for oidc)
# SSO_<N>_ALLOW_SIGNUP            true|false (default true); requires REGISTRATION_ENABLED on the instance
# SSO_<N>_ALLOWED_EMAIL_DOMAINS   optional comma-separated allowlist (e.g. "acme.com,acme.io")
#
# OIDC-only (when KIND=oidc)
# SSO_<N>_DISCOVERY_URL           .well-known/openid-configuration URL
#
# OAuth2-only (when KIND=oauth2)
# SSO_<N>_AUTHORIZATION_URL       authorization endpoint
# SSO_<N>_TOKEN_URL               token endpoint
# SSO_<N>_USERINFO_URL            endpoint returning the current user's profile
# SSO_<N>_EMAIL_CLAIM             JSON path in the userinfo response holding the email
# SSO_<N>_USERNAME_CLAIM          JSON path holding the username
# SSO_<N>_SUB_CLAIM               JSON path holding the stable subject id
# SSO_<N>_EMAILS_URL              optional fallback endpoint returning [{email, primary, verified}]
#                                 (used when userinfo has no email; typical of GitHub)
#
# ----------------------------------------------------------------------------
# Example 1 - GitHub (OAuth 2.0)
# Register at https://github.com/settings/developers
# Callback URL: ${FRONTEND_URL}/auth/sso/github/callback
# ----------------------------------------------------------------------------
# SSO_1_KIND=oauth2
# SSO_1_SLUG=github
# SSO_1_DISPLAY_NAME=GitHub
# SSO_1_ICON=simple-icons:github
# SSO_1_CLIENT_ID=Iv23xxxxxxxxxxxxxxxx
# SSO_1_CLIENT_SECRET=ghs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# SSO_1_AUTHORIZATION_URL=https://github.com/login/oauth/authorize
# SSO_1_TOKEN_URL=https://github.com/login/oauth/access_token
# SSO_1_USERINFO_URL=https://api.github.com/user
# SSO_1_EMAILS_URL=https://api.github.com/user/emails
# SSO_1_SCOPES=read:user,user:email
# SSO_1_EMAIL_CLAIM=email
# SSO_1_USERNAME_CLAIM=login
# SSO_1_SUB_CLAIM=id

# ----------------------------------------------------------------------------
# Example 2 - Google (OIDC)
# Register at https://console.cloud.google.com/apis/credentials
# ----------------------------------------------------------------------------
# SSO_2_KIND=oidc
# SSO_2_SLUG=google
# SSO_2_DISPLAY_NAME=Google
# SSO_2_ICON=simple-icons:google
# SSO_2_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
# SSO_2_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxxxx
# SSO_2_DISCOVERY_URL=https://accounts.google.com/.well-known/openid-configuration
# SSO_2_SCOPES=openid,email,profile

# ----------------------------------------------------------------------------
# Example 3 - Microsoft Entra ID (OIDC, tenant baked into the discovery URL)
# Replace <tenant> with: common | organizations | consumers | <tenant-guid>
# | <domain>.onmicrosoft.com. Register at https://entra.microsoft.com/
# ----------------------------------------------------------------------------
# SSO_3_KIND=oidc
# SSO_3_SLUG=microsoft
# SSO_3_DISPLAY_NAME=Microsoft
# SSO_3_ICON=simple-icons:microsoftazure
# SSO_3_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# SSO_3_CLIENT_SECRET=your-client-secret
# SSO_3_DISCOVERY_URL=https://login.microsoftonline.com/<tenant>/v2.0/.well-known/openid-configuration
# SSO_3_SCOPES=openid,email,profile

# ----------------------------------------------------------------------------
# Example 4 - Discord (OAuth 2.0)
# Register at https://discord.com/developers/applications
# ----------------------------------------------------------------------------
# SSO_4_KIND=oauth2
# SSO_4_SLUG=discord
# SSO_4_DISPLAY_NAME=Discord
# SSO_4_ICON=simple-icons:discord
# SSO_4_CLIENT_ID=xxxxxxxxxxxxxxxxxx
# SSO_4_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# SSO_4_AUTHORIZATION_URL=https://discord.com/oauth2/authorize
# SSO_4_TOKEN_URL=https://discord.com/api/oauth2/token
# SSO_4_USERINFO_URL=https://discord.com/api/users/@me
# SSO_4_SCOPES=identify,email
# SSO_4_EMAIL_CLAIM=email
# SSO_4_USERNAME_CLAIM=username
# SSO_4_SUB_CLAIM=id

# ----------------------------------------------------------------------------
# Example 5 - GitLab (OIDC, works self-hosted)
# For gitlab.com or replace the URL with your self-hosted instance:
# https://gitlab.mycorp.com/.well-known/openid-configuration
# ----------------------------------------------------------------------------
# SSO_5_KIND=oidc
# SSO_5_SLUG=gitlab
# SSO_5_DISPLAY_NAME=GitLab
# SSO_5_ICON=simple-icons:gitlab
# SSO_5_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# SSO_5_CLIENT_SECRET=gloas-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# SSO_5_DISCOVERY_URL=https://gitlab.com/.well-known/openid-configuration
# SSO_5_SCOPES=openid,email,profile

# ----------------------------------------------------------------------------
# Example 6 - Keycloak / Authentik / any generic OIDC
# Adjust the realm segment for Authentik:
# https://sso.corp.example.com/application/o/<slug>/.well-known/openid-configuration
# ----------------------------------------------------------------------------
# SSO_6_KIND=oidc
# SSO_6_SLUG=corp
# SSO_6_DISPLAY_NAME=Corp SSO
# SSO_6_ICON=iconoir:key
# SSO_6_CLIENT_ID=flowy
# SSO_6_CLIENT_SECRET=super-secret
# SSO_6_DISCOVERY_URL=https://sso.corp.example.com/realms/corp/.well-known/openid-configuration
# SSO_6_SCOPES=openid,email,profile
# SSO_6_ALLOWED_EMAIL_DOMAINS=corp.example.com
