generator client {
  provider = "prisma-client"
  output   = "../prisma/generated"
}

datasource db {
  provider = "postgresql"
}

enum ConfigKey {
  SELF_HOSTED
  REGISTRATION_ENABLED
  INSTANCE_OWNER

  @@map("config_keys")
}

model Config {
  key   ConfigKey @id
  value String

  @@map("config")
}

model UserSettings {
  user_id String @id @unique @db.Uuid
  user    Users  @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

enum UserRoles {
  ADMIN
  USER

  @@map("user_roles")
}

model Users {
  id                     String                  @id @default(uuid(7)) @db.Uuid
  username               String                  @db.VarChar(30)
  email                  String                  @unique
  password               String
  jwt_id                 String                  @unique
  user_settings          UserSettings?
  family_role            UserRoles?
  family_id              String?                 @db.Uuid
  family                 Family?                 @relation(fields: [family_id], references: [id], onDelete: SetNull)
  created_at             DateTime                @default(now())
  updated_at             DateTime                @updatedAt
  accounts               Accounts[]
  merchants              UserMerchants[]
  categories             UserCategories[]
  budgets                Budgets[]
  recurring_transactions RecurringTransactions[]

  @@map("users")
}

model Family {
  id         String          @id @default(uuid(7)) @db.Uuid
  name       String          @db.VarChar(50)
  currency   String          @default("USD") @db.VarChar(3)
  members    Users[]
  invites    FamilyInvites[]
  created_at DateTime        @default(now())
  updated_at DateTime        @updatedAt

  @@map("families")
}

model FamilyInvites {
  code       String   @id
  email      String   @db.VarChar(255)
  family_id  String   @db.Uuid
  family     Family   @relation(fields: [family_id], references: [id])
  created_at DateTime @default(now())
  expires_at DateTime

  @@map("family_invites")
}

enum AccountTypes {
  CHECKING // Compte courant
  SAVINGS // Compte d'épargne
  CREDIT // Carte de crédit
  CASH // Argent liquide
  INVESTMENT // Compte d'investissement
  OTHER // Autre

  @@map("account_types")
}

model Accounts {
  id                     String                  @id @default(uuid(7)) @db.Uuid
  user_id                String                  @db.Uuid
  user                   Users                   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  type                   AccountTypes
  name                   String                  @db.VarChar(50)
  balance                Float                   @default(0)
  in_budget              Boolean                 @default(true)
  transactions           Transactions[]
  recurring_transactions RecurringTransactions[]
  created_at             DateTime                @default(now())
  updated_at             DateTime                @updatedAt

  @@map("accounts")
}

model Transactions {
  id                  String                          @id @default(uuid(7)) @db.Uuid
  account_id          String                          @db.Uuid
  account             Accounts                        @relation(fields: [account_id], references: [id], onDelete: Cascade)
  amount              Float
  description         String                          @db.VarChar(255)
  date                DateTime                        @default(now())
  merchant_id         String?                         @db.Uuid
  merchant            UserMerchants?                  @relation(fields: [merchant_id], references: [id], onDelete: SetNull)
  category_id         String?                         @db.Uuid
  category            UserCategories?                 @relation(fields: [category_id], references: [id], onDelete: SetNull)
  debit_transfer      Transfers?                      @relation("TransferDebitTransaction")
  credit_transfer     Transfers?                      @relation("TransferCreditTransaction")
  recurring_execution RecurringTransactionExecutions?
  is_rebalance        Boolean                         @default(false)
  in_budget           Boolean                         @default(true)
  created_at          DateTime                        @default(now())
  updated_at          DateTime                        @updatedAt

  @@index([account_id, date(sort: Desc), created_at(sort: Desc)])
  @@index([date(sort: Desc)])
  @@index([category_id])
  @@index([merchant_id])
  @@map("transactions")
}

model Transfers {
  id                    String       @id @default(uuid(7)) @db.Uuid
  debit_transaction_id  String       @unique @db.Uuid
  credit_transaction_id String       @unique @db.Uuid
  debit_transaction     Transactions @relation("TransferDebitTransaction", fields: [debit_transaction_id], references: [id], onDelete: Cascade)
  credit_transaction    Transactions @relation("TransferCreditTransaction", fields: [credit_transaction_id], references: [id], onDelete: Cascade)
  created_at            DateTime     @default(now())
  updated_at            DateTime     @updatedAt

  @@map("transfers")
}

model UserMerchants {
  id                     String                  @id @default(uuid(7)) @db.Uuid
  user_id                String                  @db.Uuid
  user                   Users                   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  name                   String                  @db.VarChar(50)
  keywords               String[]                @default([])
  primary_keyword        String?                 @db.VarChar(50)
  auto_complete_enabled  Boolean                 @default(true)
  transactions           Transactions[]
  recurring_transactions RecurringTransactions[]
  created_at             DateTime                @default(now())
  updated_at             DateTime                @updatedAt

  @@unique([user_id, name])
  @@map("user_merchants")
}

model UserCategories {
  id                     String                  @id @default(uuid(7)) @db.Uuid
  user_id                String                  @db.Uuid
  user                   Users                   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  name                   String                  @db.VarChar(50)
  hex_color              String                  @db.VarChar(7)
  icon                   String                  @db.VarChar(50)
  keywords               String[]                @default([])
  primary_keyword        String?                 @db.VarChar(50)
  auto_complete_enabled  Boolean                 @default(true)
  created_at             DateTime                @default(now())
  updated_at             DateTime                @updatedAt
  transactions           Transactions[]
  budgeted_categories    BudgetedCategories[]
  recurring_transactions RecurringTransactions[]

  @@unique([user_id, name])
  @@map("user_categories")
}

model Budgets {
  id                  String               @id @default(uuid(7)) @db.Uuid
  user_id             String               @db.Uuid
  user                Users                @relation(fields: [user_id], references: [id], onDelete: Cascade)
  month               Int
  year                Int
  budgeted_income     Float
  created_at          DateTime             @default(now())
  updated_at          DateTime             @updatedAt
  budgeted_categories BudgetedCategories[]

  @@unique([user_id, month, year])
  @@map("budgets")
}

model BudgetedCategories {
  budget_id   String         @db.Uuid
  category_id String         @db.Uuid
  amount      Float
  budget      Budgets        @relation(fields: [budget_id], references: [id], onDelete: Cascade)
  category    UserCategories @relation(fields: [category_id], references: [id], onDelete: Cascade)
  created_at  DateTime       @default(now())
  updated_at  DateTime       @updatedAt

  @@id([budget_id, category_id])
  @@map("budgeted_categories")
}

enum RecurrenceFrequency {
  WEEKLY
  MONTHLY
  BIMONTHLY
  QUARTERLY
  SEMIANNUAL
  YEARLY

  @@map("recurrence_frequency")
}

model RecurringTransactions {
  id              String                           @id @default(uuid(7)) @db.Uuid
  user_id         String                           @db.Uuid
  user            Users                            @relation(fields: [user_id], references: [id], onDelete: Cascade)
  account_id      String                           @db.Uuid
  account         Accounts                         @relation(fields: [account_id], references: [id], onDelete: Cascade)
  name            String                           @db.VarChar(255)
  amount          Float
  merchant_id     String?                          @db.Uuid
  merchant        UserMerchants?                   @relation(fields: [merchant_id], references: [id], onDelete: SetNull)
  category_id     String?                          @db.Uuid
  category        UserCategories?                  @relation(fields: [category_id], references: [id], onDelete: SetNull)
  frequency       RecurrenceFrequency
  day_of_month    Int?
  day_of_week     Int?
  month_of_year   Int?
  timezone        String                           @db.VarChar(64)
  in_budget       Boolean                          @default(true)
  is_enabled      Boolean                          @default(true)
  next_run_at     DateTime
  last_run_at     DateTime?
  last_failure_at DateTime?
  executions      RecurringTransactionExecutions[]
  created_at      DateTime                         @default(now())
  updated_at      DateTime                         @updatedAt

  @@index([user_id])
  @@index([account_id])
  @@index([next_run_at])
  @@map("recurring_transactions")
}

enum RecurringExecutionStatus {
  CREATED
  SKIPPED
  FAILED

  @@map("recurring_execution_status")
}

model RecurringTransactionExecutions {
  id                       String                   @id @default(uuid(7)) @db.Uuid
  recurring_transaction_id String                   @db.Uuid
  recurring_transaction    RecurringTransactions    @relation(fields: [recurring_transaction_id], references: [id], onDelete: Cascade)
  transaction_id           String?                  @unique @db.Uuid
  transaction              Transactions?            @relation(fields: [transaction_id], references: [id], onDelete: SetNull)
  status                   RecurringExecutionStatus
  error_message            String?
  scheduled_for            DateTime
  executed_at              DateTime                 @default(now())

  @@index([recurring_transaction_id, executed_at(sort: Desc)])
  @@map("recurring_transaction_executions")
}
