{
    "id": "/",
    "name": "Flowy",
    "short_name": "Flowy",
    "description": "Flowy is a self-hosted finance platform built for people who are tired of juggling spreadsheets, disconnected banking apps, and shared Google Sheets that nobody agrees on.",
    "lang": "en",
    "dir": "ltr",
    "start_url": "/",
    "scope": "/",
    "display": "standalone",
    "orientation": "any",
    "theme_color": "#3b6cff",
    "background_color": "#0b0b0f",
    "categories": ["finance"],
    "prefer_related_applications": false,
    "launch_handler": {
        "client_mode": "focus-existing"
    },
    "handle_links": "preferred",
    "icons": [
        {
            "src": "/pwa-64x64.png",
            "sizes": "64x64",
            "type": "image/png"
        },
        {
